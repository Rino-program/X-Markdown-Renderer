{
  "manifest_version": 3,
  "name": "X Markdown Renderer",
  "version": "1.0.1",
  "description": "Markdown形式で書かれたXのポストを、自動的にMarkdown適用済みの表示に変換します。",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "X Markdown Renderer",
    "default_popup": "popup.html"
  }
}
